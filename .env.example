# Copy to .env and fill in. Never commit .env.

# AllegroGraph (required)
AG_URL=https://your-allegrograph-host
AG_USER=
AG_PASS=
AG_CATALOG=mycatalog
AG_REPO=FEEKG
# AG_TIMEOUT=30
# AG_RETRIES=2

# API
# Comma-separated origins allowed to call the API from a browser (empty = none).
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# API_MAX_LIMIT=5000
# CACHE_TTL=300
# PORT=5001
# WEB_CONCURRENCY=2
